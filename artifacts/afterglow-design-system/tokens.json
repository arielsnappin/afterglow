        "$description": "source glass-strong"
      },
      "sidebarAccentForeground": {
        "$value": "#17121f",
        "$description": "source ink"
      },
      "sidebarRing": {
        "$value": "#c2006a",
        "$description": "source focus"
      }
    },
    "dark": {
      "background": {
        "$value": "#0e0b16",
        "$description": "source bg"
      },
      "foreground": {
        "$value": "#fbf7ff",
        "$description": "source ink"
      },
      "border": {
        "$value": "rgba(255,255,255,0.16)",
        "$description": "source line"
      },
      "card": {
        "$value": "#1a1528",
        "$description": "source bg-raised (solid card fallback)"
      },
      "cardForeground": {
        "$value": "#fbf7ff",
        "$description": "source ink"
      },
      "popover": {
        "$value": "#1a1528",
        "$description": "source bg-raised"
      },
      "popoverForeground": {
        "$value": "#fbf7ff",
        "$description": "source ink"
      },
      "primary": {
        "$value": "#ff4fa3",
        "$description": "source pop: the one primary action per view"
      },
      "primaryForeground": {
        "$value": "#17121f",
        "$description": "source on-bright: never white on neon"
      },
      "secondary": {
        "$value": "rgba(255,255,255,0.14)",
        "$description": "source glass-strong"
      },
      "secondaryForeground": {
        "$value": "#fbf7ff",
        "$description": "source ink"
      },
      "muted": {
        "$value": "rgba(255,255,255,0.08)",
        "$description": "source glass"
      },
      "mutedForeground": {
        "$value": "#b8afc8",
        "$description": "source ink-muted"
      },
      "accent": {
        "$value": "rgba(255,255,255,0.14)",
        "$description": "source glass-strong (hover / highlighted rows)"
      },
      "accentForeground": {
        "$value": "#fbf7ff",
        "$description": "source ink"
      },
      "destructive": {
        "$value": "#ff5c5c",
        "$description": "source danger: errors only"
      },
      "destructiveForeground": {
        "$value": "#17121f",
        "$description": "source on-bright on light danger"
      },
      "input": {
        "$value": "rgba(255,255,255,0.16)",
        "$description": "source line: input outline at rest"
      },
      "ring": {
        "$value": "#c6ff3d",
        "$description": "source focus"
      },
      "chart1": {
        "$value": "#ff4fa3",
        "$description": "source pop"
      },
      "chart2": {
        "$value": "#c6ff3d",
        "$description": "source zap"
      },
      "chart3": {
        "$value": "#ffd23d",
        "$description": "source sun"
      },
      "chart4": {
        "$value": "#3de0ff",
        "$description": "source sky"
      },
      "chart5": {
        "$value": "#b28cff",
        "$description": "source grape"
      },
      "sidebar": {
        "$value": "#0e0b16",
        "$description": "source bg"
      },
      "sidebarForeground": {
        "$value": "#fbf7ff",
        "$description": "source ink"
      },
      "sidebarBorder": {
        "$value": "rgba(255,255,255,0.16)",
        "$description": "source line"
      },
      "sidebarPrimary": {
        "$value": "#ff4fa3",
        "$description": "source pop"
      },
      "sidebarPrimaryForeground": {
        "$value": "#17121f",
        "$description": "source on-bright"
      },
      "sidebarAccent": {
        "$value": "rgba(255,255,255,0.14)",
        "$description": "source glass-strong"
      },
      "sidebarAccentForeground": {
        "$value": "#fbf7ff",
        "$description": "source ink"
      },
      "sidebarRing": {
        "$value": "#c6ff3d",
        "$description": "source focus"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "DM Sans",
          "system-ui",
          "-apple-system",
          "sans-serif"
        ],
        "$description": "source body family"
      },
      "display": {
        "$value": [
          "Bricolage Grotesque",
          "Arial Black",
          "system-ui",
          "sans-serif"
        ],
        "$description": "source display family (800, tight tracking)"
      },
      "serif": {
        "$value": [
          "Instrument Serif",
          "Georgia",
          "serif"
        ],
        "$description": "source accent family: Instrument Serif italic flourish, one or two words only"
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "System fallback role only (not part of the source system)."
      }
    },
    "fontImport": {
      "$type": "string",
      "$value": "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..800&family=DM+Sans:opsz,wght@9..40,400..700&family=Instrument+Serif:ital@1&display=swap",
      "$description": "Source bundle.css font import; emitted as the first line of src/index.css."
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "24px",
      "$description": "source radius-lg; Tailwind rounded-sm/md/lg/xl map to source radius-sm/md/lg/xl (10/16/24/32px)."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "source 4px base"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": {
        "$value": "120ms",
        "$description": "press"
      },
      "base": {
        "$value": "220ms",
        "$description": "select"
      },
      "slow": {
        "$value": "360ms",
        "$description": "enter"
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": "cubic-bezier(.22, 1, .36, 1)",
        "$description": "source --ag-ease-out"
      },
      "bounce": {
        "$value": "cubic-bezier(.34, 1.56, .64, 1)",
        "$description": "source --ag-ease-bounce"
      }
    }
  },
  "elevation": {
    "$type": "shadow",
    "light": {
      "sm": {
        "$value": "0 1px 2px rgba(70,20,60,0.08)"
      },
      "md": {
        "$value": "0 6px 16px rgba(70,20,60,0.10)"
      },
      "lg": {
        "$value": "0 12px 32px rgba(70,20,60,0.12)",
        "$description": "source shadow-card"
      }
    },
    "dark": {
      "sm": {
        "$value": "0 1px 2px rgba(0,0,0,0.40)"
      },
      "md": {
        "$value": "0 8px 24px rgba(0,0,0,0.40)"
      },
      "lg": {
        "$value": "0 16px 48px rgba(0,0,0,0.45)",
        "$description": "source shadow-card"
      }
    }
  },
  "$extensions": {
    "afterglow": {
      "$description": "Verbatim uploaded source tokens. The generator emits every color (per theme), type family, type style (as type-* utilities), spacing, radius, shadow and blur token as CSS variables with the source names, and appends scripts/source/afterglow-components.css (source bundle.css minus its font import) inside @layer components.",
      "source": {
        "name": "Afterglow",
        "version": 1,
        "color": {
          "themes": [
            {
              "id": "dark",
              "name": "Night out"
            },
            {
              "id": "light",
              "name": "Day party"
            }
          ],
          "tokens": [
            {
              "name": "bg",
              "value": {
                "dark": "#0e0b16",
                "light": "#fff6ee"
              },
              "usage": "Page background: a clean, solid deep-ink ground (cream in Day party) that lets full-value color blocks pop, exactly as on the cover. Aura glows are optional."
            },
            {
              "name": "bg-raised",
              "value": {
                "dark": "#1a1528",
                "light": "#ffffff"
              },
              "usage": "Solid raised surfaces where blur is unavailable or too costly (long lists, Android fallbacks)."
            },
            {
              "name": "glass",
              "value": {
                "dark": "rgba(255,255,255,0.08)",
                "light": "rgba(255,255,255,0.72)"
              },
              "usage": "Frosted panel fill. Always use with backdrop-filter blur(var(--blur-glass)) and a line border."
            },
            {
              "name": "glass-strong",
              "value": {
                "dark": "rgba(255,255,255,0.14)",
                "light": "rgba(255,255,255,0.92)"
              },
              "usage": "Hover/pressed glass, sheets and modals that sit above other glass."
            },
            {
              "name": "line",
              "value": {
                "dark": "rgba(255,255,255,0.16)",
                "light": "rgba(23,18,31,0.12)"
              },
              "usage": "1px borders on glass, dividers, input outlines at rest."
            },
            {
              "name": "ink",
              "value": {
                "dark": "#fbf7ff",
                "light": "#17121f"
              },
              "usage": "Primary text and icons on bg, bg-raised and glass in both themes."
            },
            {
              "name": "ink-muted",
              "value": {
                "dark": "#b8afc8",
                "light": "#5c5370"
              },
              "usage": "Secondary text (meta, captions, hints) on bg and glass; 4.5:1+ in both themes."
            },
            {
              "name": "pop",
              "value": "#ff4fa3",
              "usage": "Hero accent: the primary action, the brand moment. Fill only; text on it is on-bright."
            },
            {
              "name": "pop-ink",
              "value": {
                "dark": "#ff86c0",
                "light": "#c2006a"
              },
              "usage": "Pink when it has to be text or a link on bg / glass (pop itself is too light for text on Day party)."
            },
            {
              "name": "zap",
              "value": "#c6ff3d",
              "usage": "Electric lime. 'Going' state, success, secondary celebratory actions. Fill only, with on-bright text."
            },
            {
              "name": "sun",
              "value": "#ffd23d",
              "usage": "Warm yellow. 'Maybe' state, highlights, stickers. Fill only."
            },
            {
              "name": "sky",
              "value": "#3de0ff",
              "usage": "Cyan accent for color blocks, posters, avatars and stickers. Fill only."
            },
            {
              "name": "grape",
              "value": "#b28cff",
              "usage": "Soft violet for color blocks, posters, avatars and stickers. Fill only; never blended with sky in a gradient."
            },
            {
              "name": "on-bright",
              "value": "#17121f",
              "usage": "Text, icons and sticker outlines on any neon fill (pop, zap, sun, sky, grape). Never white on neon."
            },
            {
              "name": "danger",
              "value": {
                "dark": "#ff5c5c",
                "light": "#d61f3a"
              },
              "usage": "Errors and destructive confirmations only. Text-safe on bg in both themes."
            },
            {
              "name": "focus",
              "value": {
                "dark": "#c6ff3d",
                "light": "#c2006a"
              },
              "usage": "Keyboard focus ring: 3px solid, 3px offset."
            },
            {
              "name": "aura-1",
              "value": {
                "dark": "rgba(255,79,163,0.16)",
                "light": "rgba(255,79,163,0.10)"
              },
              "usage": "Optional faint pink glow (opt in with ag-root--aura) behind glass-heavy screens; also the pink focus halo on inputs. Never strong enough to tint the color blocks."
            },
            {
              "name": "aura-2",
              "value": {
                "dark": "rgba(255,210,61,0.10)",
                "light": "rgba(255,210,61,0.14)"
              },
              "usage": "Optional faint warm glow paired with aura-1 (opt in with ag-root--aura)."
            }
          ]
        },
        "type": {
          "fonts": [],
          "families": {
            "display": "\"Bricolage Grotesque\", \"Arial Black\", system-ui, sans-serif",
            "body": "\"DM Sans\", system-ui, -apple-system, sans-serif",
            "accent": "\"Instrument Serif\", Georgia, serif"
          },
          "groups": [
            {
              "name": "Display",
              "family": "display",
              "styles": [
                {
                  "name": "display-xl",
                  "fontSize": "64px",
                  "lineHeight": "60px",
                  "fontWeight": 800,
                  "letterSpacing": "-0.03em",
                  "sample": "Rooftop szn ☀️",
                  "usage": "Event titles on posters and hero moments. One per screen."
                },
                {
                  "name": "display-lg",
                  "fontSize": "44px",
                  "lineHeight": "44px",
                  "fontWeight": 800,
                  "letterSpacing": "-0.025em",
                  "sample": "You're invited",
                  "usage": "Screen titles, invite headers."
                },
                {
                  "name": "title",
                  "fontSize": "28px",
                  "lineHeight": "32px",
                  "fontWeight": 700,
                  "letterSpacing": "-0.015em",
                  "sample": "Who's going",
                  "usage": "Section headers, card titles."
                }
              ]
            },
            {
              "name": "Text",
              "family": "body",
              "styles": [
                {
                  "name": "body-lg",
                  "fontSize": "18px",
                  "lineHeight": "26px",
                  "fontWeight": 500,
                  "sample": "Bring snacks, bring friends, bring the vibes.",
                  "usage": "Invite descriptions, intro copy."
                },
                {
                  "name": "body",
                  "fontSize": "16px",
                  "lineHeight": "24px",
                  "fontWeight": 400,
                  "sample": "Saturday at 8pm · The roof at Mika's",
                  "usage": "Default UI text."
                },
                {
                  "name": "label",
                  "fontSize": "14px",
                  "lineHeight": "20px",
                  "fontWeight": 600,
                  "sample": "Going · 24",
                  "usage": "Buttons (small), field labels, tabs, counts."
                },
                {
                  "name": "caption",
                  "fontSize": "12px",
                  "lineHeight": "16px",
                  "fontWeight": 500,
                  "letterSpacing": "0.02em",
                  "sample": "Hosted by Ariel",
                  "usage": "Timestamps, helper text, sticker text."
                }
              ]
            },
            {
              "name": "Accent",
              "family": "accent",
              "styles": [
                {
                  "name": "flourish",
                  "fontSize": "36px",
                  "lineHeight": "40px",
                  "fontWeight": 400,
                  "fontStyle": "italic",
                  "sample": "obviously",
                  "usage": "One or two words of personality inside a display line. Never a full sentence."
                }
              ]
            }
          ]
        },
        "spacing": {
          "tokens": [
            {
              "name": "space-1",
              "value": "4px",
              "usage": "Icon-to-label nudge, avatar overlap offsets."
            },
            {
              "name": "space-2",
              "value": "8px",
              "usage": "Gap between chips, inline elements."
            },
            {
              "name": "space-3",
              "value": "12px",
              "usage": "Gap between buttons in a row, RSVP options."
            },
            {
              "name": "space-4",
              "value": "16px",
              "usage": "Card padding (compact), list row padding."
            },
            {
              "name": "space-5",
              "value": "20px",
              "usage": "Button horizontal padding, field padding."
            },
            {
              "name": "space-6",
              "value": "24px",
              "usage": "Card padding (default), screen side margins."
            },
            {
              "name": "space-8",
              "value": "32px",
              "usage": "Gap between sections."
            },
            {
              "name": "space-12",
              "value": "48px",
              "usage": "Hero breathing room, top of screen."
            }
          ]
        },
        "radius": {
          "tokens": [
            {
              "name": "radius-sm",
              "value": "10px",
              "usage": "Small chips, inputs inside cards."
            },
            {
              "name": "radius-md",
              "value": "16px",
              "usage": "Inputs, list rows, small cards."
            },
            {
              "name": "radius-lg",
              "value": "24px",
              "usage": "Glass cards, sheets."
            },
            {
              "name": "radius-xl",
              "value": "32px",
              "usage": "Event posters, hero cards."
            },
            {
              "name": "radius-pill",
              "value": "999px",
              "usage": "Buttons, RSVP options, stickers, avatars. Default for anything tappable."
            }
          ]
        },
        "shadow": {
          "tokens": [
            {
              "name": "glow-pop",
              "value": {
                "dark": "0 8px 32px rgba(255,79,163,0.45)",
                "light": "0 8px 24px rgba(255,79,163,0.35)"
              },
              "usage": "Under the primary pop button only."
            },
            {
              "name": "glow-zap",
              "value": {
                "dark": "0 8px 28px rgba(198,255,61,0.35)",
                "light": "0 6px 20px rgba(120,170,0,0.28)"
              },
              "usage": "Under a selected 'Going' RSVP and zap buttons."
            },
            {
              "name": "shadow-card",
              "value": {
                "dark": "0 16px 48px rgba(0,0,0,0.45)",
                "light": "0 12px 32px rgba(70,20,60,0.12)"
              },
              "usage": "Glass cards and event posters floating over the aura."
            }
          ]
        },
        "blur": {
          "tokens": [
            {
              "name": "blur-glass",
              "value": "20px",
              "usage": "backdrop-filter on glass panels, buttons and nav bars."
            },
            {
              "name": "blur-heavy",
              "value": "40px",
              "usage": "Full-screen modal backdrops and blurred poster backgrounds."
            }
          ]
        }
      }
    }
  }
}
