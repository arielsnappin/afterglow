      },
      "mutedForeground": {
        "$value": "#5c5370",
        "$description": "source ink-muted"
      },
      "accent": {
        "$value": "rgba(255,255,255,0.92)",
        "$description": "source glass-strong (hover / highlighted rows)"
      },
      "accentForeground": {
        "$value": "#17121f",
        "$description": "source ink"
      },
      "destructive": {
        "$value": "#d61f3a",
        "$description": "source danger: errors only"
      },
      "destructiveForeground": {
        "$value": "#ffffff",
        "$description": "white on deep danger (not a neon)"
      },
      "input": {
        "$value": "rgba(23,18,31,0.12)",
        "$description": "source line: input outline at rest"
      },
      "ring": {
        "$value": "#c2006a",
        "$description": "source focus"
      },
      "chart1": {
        "$value": "#ff4fa3",
        "$description": "source pop"
      },
      "chart2": {
        "$value": "#c6ff3d",
        "$description": "source zap"
      },
      "chart3": {
        "$value": "#ffd23d",
        "$description": "source sun"
      },
      "chart4": {
        "$value": "#3de0ff",
        "$description": "source sky"
      },
      "chart5": {
        "$value": "#b28cff",
        "$description": "source grape"
      },
      "sidebar": {
        "$value": "#fff6ee",
        "$description": "source bg"
      },
      "sidebarForeground": {
        "$value": "#17121f",
        "$description": "source ink"
      },
      "sidebarBorder": {
        "$value": "rgba(23,18,31,0.12)",
        "$description": "source line"
      },
      "sidebarPrimary": {
        "$value": "#ff4fa3",
        "$description": "source pop"
      },
      "sidebarPrimaryForeground": {
        "$value": "#17121f",
        "$description": "source on-bright"
      },
      "sidebarAccent": {
