{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Afterglow design tokens (DTCG). SINGLE SOURCE OF TRUTH. Edit here only, then run pnpm tokens; never hand-edit src/index.css, src/generated/tokens.tsx, or public/favicon.svg. Mapped from the user-uploaded Afterglow system (docs/references/uploaded-system): Night out (dark, default) and Day party (light). Standard shadcn roles alias the source roles; the verbatim source tokens live under $extensions.afterglow.source and are emitted as source CSS variables (--bg, --pop, --glass, ...).",
  "color": {
    "$type": "color",
    "light": {
      "background": {
        "$value": "#fff6ee",
        "$description": "source bg"
      },
      "foreground": {
        "$value": "#17121f",
        "$description": "source ink"
      },
      "border": {
        "$value": "rgba(23,18,31,0.12)",
        "$description": "source line"
      },
      "card": {
        "$value": "#ffffff",
        "$description": "source bg-raised (solid card fallback)"
      },
      "cardForeground": {
        "$value": "#17121f",
        "$description": "source ink"
      },
      "popover": {
        "$value": "#ffffff",
        "$description": "source bg-raised"
      },
      "popoverForeground": {
        "$value": "#17121f",
        "$description": "source ink"
      },
      "primary": {
        "$value": "#ff4fa3",
        "$description": "source pop: the one primary action per view"
      },
      "primaryForeground": {
        "$value": "#17121f",
        "$description": "source on-bright: never white on neon"
      },
      "secondary": {
        "$value": "rgba(255,255,255,0.92)",
        "$description": "source glass-strong"
      },
      "secondaryForeground": {
        "$value": "#17121f",
        "$description": "source ink"
      },
      "muted": {
        "$value": "rgba(255,255,255,0.72)",
